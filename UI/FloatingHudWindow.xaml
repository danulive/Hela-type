<Window x:Class="HelaType.UI.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Focusable="False">
    <Border x:Name="RootBorder"
            Margin="12"
            Background="#F018181B"
            BorderBrush="#38FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10,7"
            Focusable="False"
            Cursor="SizeAll"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            MouseMove="RootBorder_MouseMove"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="14"
                              ShadowDepth="3"
                              Opacity="0.52" />
        </Border.Effect>

        <StackPanel Orientation="Vertical" Focusable="False">
            <!-- Top Row: Mode Badge + Live Roman->Sinhala Buffer or Mode Toast -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Focusable="False">
                <Border x:Name="ModeBadgeBorder"
                        Background="#10B981"
                        CornerRadius="6"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Focusable="False"
                        Cursor="Hand"
                        ToolTip="Double-click to snap HUD back to text caret"
                        MouseLeftButtonDown="ModeBadgeBorder_MouseLeftButtonDown">
                    <TextBlock x:Name="ModeBadgeText"
                               Text="සිං"
                               Foreground="#FFFFFF"
                               FontFamily="Nirmala UI, Iskoola Pota, Segoe UI"
                               FontSize="12.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Focusable="False" />
                </Border>

                <StackPanel x:Name="BufferPreviewPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="9,0,2,0"
                            Visibility="Collapsed"
                            Focusable="False">
                    <TextBlock x:Name="RomanBufferText"
                               Text=""
                               Foreground="#A1A1AA"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Focusable="False" />
                    <TextBlock Text=" → "
                               Foreground="#52525B"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Focusable="False" />
                    <TextBlock x:Name="SinhalaPreviewText"
                               Text=""
                               Foreground="#F4F4F5"
                               FontFamily="Nirmala UI, Iskoola Pota, Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Focusable="False" />
                </StackPanel>

                <TextBlock x:Name="ModeToastText"
                           Text=""
                           Foreground="#E4E4E7"
                           FontFamily="Segoe UI, Nirmala UI"
                           FontSize="12.5"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="9,0,4,0"
                           Visibility="Collapsed"
                           Focusable="False" />
            </StackPanel>

            <!-- Bottom Row: F1 / F2 / F3 Phonetic Variations -->
            <StackPanel x:Name="CandidatesPanel"
                        Orientation="Horizontal"
                        Margin="0,7,0,0"
                        Visibility="Collapsed"
                        Focusable="False">
                <Border x:Name="Candidate0Border"
                        Background="#2210B981"
                        BorderBrush="#5510B981"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="7,3"
                        Margin="0,0,6,0"
                        Cursor="Hand"
                        Focusable="False"
                        Tag="0"
                        MouseLeftButtonDown="CandidatePill_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Focusable="False">
                        <TextBlock Text="F1 "
                                   Foreground="#34D399"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Focusable="False" />
                        <TextBlock x:Name="Candidate0Text"
                                   Text=""
                                   Foreground="#ECFDF5"
                                   FontFamily="Nirmala UI, Iskoola Pota, Segoe UI"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Focusable="False" />
                    </StackPanel>
                </Border>

                <Border x:Name="Candidate1Border"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="7,3"
                        Margin="0,0,6,0"
                        Cursor="Hand"
                        Focusable="False"
                        Tag="1"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="CandidatePill_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Focusable="False">
                        <TextBlock Text="F2 "
                                   Foreground="#94A3B8"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Focusable="False" />
                        <TextBlock x:Name="Candidate1Text"
                                   Text=""
                                   Foreground="#E4E4E7"
                                   FontFamily="Nirmala UI, Iskoola Pota, Segoe UI"
                                   FontSize="13.5"
                                   VerticalAlignment="Center"
                                   Focusable="False" />
                    </StackPanel>
                </Border>

                <Border x:Name="Candidate2Border"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="7,3"
                        Cursor="Hand"
                        Focusable="False"
                        Tag="2"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="CandidatePill_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Focusable="False">
                        <TextBlock Text="F3 "
                                   Foreground="#94A3B8"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Focusable="False" />
                        <TextBlock x:Name="Candidate2Text"
                                   Text=""
                                   Foreground="#E4E4E7"
                                   FontFamily="Nirmala UI, Iskoola Pota, Segoe UI"
                                   FontSize="13.5"
                                   VerticalAlignment="Center"
                                   Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
