<Window x:Class="HelaType.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelaType Windows — Singlish to Sinhala Unicode"
        Width="1060"
        Height="700"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI, Nirmala UI, Iskoola Pota">

    <Window.Resources>
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="BorderBrush" Value="#27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E10B981" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52525B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981"
                            CornerRadius="9"
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0">
                        <TextBlock Text="සිං"
                                   Foreground="#FFFFFF"
                                   FontFamily="Nirmala UI, Iskoola Pota"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HelaType Windows"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FAFAFA" />
                        <TextBlock Text="System-wide Singlish to Sinhala Unicode Phonetic IME (WH_KEYBOARD_LL + Atomic SendInput)"
                                   FontSize="12"
                                   Foreground="#A1A1AA" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="PinHudCheckBox"
                              Content="Pin HUD"
                              Foreground="#D4D4D8"
                              FontSize="12.5"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Checked="PinHudCheckBox_Changed"
                              Unchecked="PinHudCheckBox_Changed" />

                    <CheckBox x:Name="StartupCheckBox"
                              Content="Start with Windows"
                              Foreground="#D4D4D8"
                              FontSize="12.5"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Checked="StartupCheckBox_Changed"
                              Unchecked="StartupCheckBox_Changed" />

                    <Button x:Name="ModeToggleButton"
                            Click="ModeToggleButton_Click"
                            Margin="0,0,10,0"
                            Padding="14,7"
                            Style="{StaticResource PillButtonStyle}" />

                    <Button Content="Minimize to Tray"
                            Click="MinimizeToTrayButton_Click"
                            Style="{StaticResource PillButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: Left Live Sandbox + Right Phonetic Cheat Sheet -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Left Card: Live Sandbox -->
            <Border Grid.Column="0"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Live Sandbox Pad"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FAFAFA" />
                            <TextBlock Text="Works identically here or in Chrome, WhatsApp, Word, and Notepad."
                                       FontSize="12"
                                       Foreground="#A1A1AA" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Copy"
                                    Click="CopySandboxButton_Click"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PillButtonStyle}" />
                            <Button Content="Clear"
                                    Click="ClearSandboxButton_Click"
                                    Style="{StaticResource PillButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#09090B"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="10">
                        <Grid>
                            <TextBlock x:Name="SandboxWatermark"
                                       Text="Click here and start typing Singlish...&#x0a;&#x0a;Try typing:&#x0a;• kohomadha &#x0a;• aayuboowan shrii langkaa&#x0a;• vidhyaa / kaRma / kruthya&#x0a;&#x0a;Press Ctrl+Space or Alt+Z to switch between Sinhala and English."
                                       Foreground="#52525B"
                                       FontFamily="Nirmala UI, Segoe UI"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"
                                       Margin="6,4" />

                            <TextBox x:Name="SandboxTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F4F4F5"
                                     CaretBrush="#10B981"
                                     SelectionBrush="#10B981"
                                     FontFamily="Nirmala UI, Iskoola Pota, Segoe UI"
                                     FontSize="20"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="SandboxTextBox_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Live Buffer & Candidate Telemetry Bar -->
                    <Border Grid.Row="2"
                            Background="#111318"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="LiveStatusDot"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="#10B981"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="Active Buffer: "
                                           Foreground="#A1A1AA"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveRomanText"
                                           Text="(idle)"
                                           Foreground="#D4D4D8"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="  →  "
                                           Foreground="#52525B"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveSinhalaText"
                                           Text="—"
                                           Foreground="#34D399"
                                           FontFamily="Nirmala UI, Iskoola Pota"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="LiveCandidatesText"
                                       Grid.Row="1"
                                       Text="Type a Singlish word to preview live F1 / F2 / F3 phonetic alternatives."
                                       Foreground="#71717A"
                                       FontFamily="Nirmala UI, Segoe UI"
                                       FontSize="12"
                                       Margin="0,5,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Card: Interactive Phonetic Cheat Sheet -->
            <Border Grid.Column="2"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Singlish Phonetic Cheat Sheet"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FAFAFA" />
                        <TextBlock Text="Click any card below to insert its Sinhala example into the Sandbox."
                                   FontSize="12"
                                   Foreground="#A1A1AA" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <RadioButton Content="All" IsChecked="True" Tag="All" Click="FilterChip_Click" Style="{StaticResource FilterChipStyle}" />
                        <RadioButton Content="Vowels" Tag="Vowels" Click="FilterChip_Click" Style="{StaticResource FilterChipStyle}" />
                        <RadioButton Content="Consonants" Tag="Consonants" Click="FilterChip_Click" Style="{StaticResource FilterChipStyle}" />
                        <RadioButton Content="Sanyaka &amp; Special" Tag="Sanyaka &amp; Special" Click="FilterChip_Click" Style="{StaticResource FilterChipStyle}" />
                        <RadioButton Content="Conjuncts" Tag="Conjuncts" Click="FilterChip_Click" Style="{StaticResource FilterChipStyle}" />
                    </WrapPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CheatSheetItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111318"
                                            BorderBrush="#27272A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="11,8"
                                            Margin="0,0,6,7"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="CheatSheetCard_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="#1E293B"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SinglishKey}"
                                                           Foreground="#34D399"
                                                           FontFamily="Consolas, Segoe UI"
                                                           FontSize="12"
                                                           FontWeight="Bold" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SinhalaOutput}"
                                                       Foreground="#FAFAFA"
                                                       FontFamily="Nirmala UI, Iskoola Pota"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ExampleInput}"
                                                               Foreground="#A1A1AA"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="11.5" />
                                                    <TextBlock Text=" → "
                                                               Foreground="#52525B"
                                                               FontSize="11.5" />
                                                    <TextBlock Text="{Binding ExampleOutput}"
                                                               Foreground="#E4E4E7"
                                                               FontFamily="Nirmala UI, Iskoola Pota"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Notes}"
                                                           Foreground="#71717A"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Shortcuts: Ctrl+Space or Alt+Z (Toggle Sinhala/English)  •  F1 / F2 / F3 (Pick Variant)  •  Closing window hides to System Tray"
                       Foreground="#71717A"
                       FontSize="12"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Exit HelaType"
                    Click="ExitButton_Click"
                    Foreground="#FCA5A5"
                    BorderBrush="#7F1D1D"
                    Background="#2A1215"
                    Style="{StaticResource PillButtonStyle}" />
        </Grid>
    </Grid>
</Window>
