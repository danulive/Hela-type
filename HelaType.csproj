<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HelaType</AssemblyName>
    <RootNamespace>HelaType</RootNamespace>
    <Title>HelaType Windows</Title>
    <Description>Real-time Singlish (Romanized Sinhala) to Sinhala Unicode phonetic Input Method utility</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
